# Copie para .env.local e preencha. Nunca commite o .env.local.

# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor. Nunca use NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL da aplicação ---
# Usada no navegador (links, redirecionamentos de login).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Usada no servidor (webhook da Evolution, Stripe, Google Agenda). Em produção, a URL da Vercel.
APP_URL=http://localhost:3000

# --- WhatsApp / Evolution API (opcional) ---
NEXT_PUBLIC_EVOLUTION_ENABLED=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Chave que a Evolution envia no header Authorization: Bearer <chave> ao chamar o webhook.
EVOLUTION_WEBHOOK_KEY=

# --- Stripe (planos e cobrança) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Google Agenda (opcional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Ex.: https://seu-dominio.vercel.app/api/integrations/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=
# Opcional; padrão: https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_SCOPES=
# Chave para criptografar o refresh token. Se vazio, usa GOOGLE_CLIENT_SECRET.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- Prospecção no Google (SerpAPI, opcional) ---
SERPAPI_API_KEY=
# Opcional; padrão: https://serpapi.com/search.json
SERPAPI_SEARCH_ENDPOINT=
