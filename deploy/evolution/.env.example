# Copie para .env (neste mesmo diretório, no servidor) e preencha.

# Subdomínio apontado para o IP do servidor (registro A no DNS). Ex.: evolution.seudominio.com.br
EVOLUTION_DOMAIN=

# Chave global da Evolution. É o mesmo valor de EVOLUTION_API_KEY na Vercel.
# Gere com: openssl rand -hex 32
AUTHENTICATION_API_KEY=

# Senha do Postgres interno. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=
